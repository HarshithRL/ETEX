# Nexus Mate — environment checklist
# The app reads process env vars (PowerShell $env:...), not this file automatically.
# Copy values into your shell. Do not commit a real .env.

# --- required for local chat / identity ---
DATABRICKS_CONFIG_PROFILE=adb-7181820732839861

# --- optional Databricks ---
# DATABRICKS_MODEL=system.ai.claude-sonnet-5
# DATABRICKS_MAX_TOKENS=1024
# DATABRICKS_TEMPERATURE=
# DATABRICKS_HOST=https://adb-7181820732839861.1.azuredatabricks.net
# Point this at the Databricks embedding serving/gateway name when ready.
# DATABRICKS_EMBEDDING_MODEL=databricks-embedding-placeholder

# --- Flask ---
# FLASK_SECRET_KEY=change-me-locally

# --- logging ---
# MATE_ENV=dev
# MATE_LOG_LEVEL=DEBUG
# MATE_LOG_FORMAT=pretty
# MATE_LOG_DIR=logs
# MATE_STDLIB_LOG_LEVEL=WARNING
# MATE_SHOW_REASONING=1

# --- local data ---
# MATE_SQLITE_PATH=mate.sqlite
# MATE_PROJECTS_DATA_ROOT=

# --- Databricks Apps only (set by the platform) ---
# DATABRICKS_APP_NAME=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
